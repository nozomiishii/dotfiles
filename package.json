{
  "name": "dotfiles",
  "version": "1.0.0",
  "description": "Doting Dotfiles",
  "homepage": "https://github.com/nozomiishii/dotfiles#readme",
  "bugs": {
    "url": "https://github.com/nozomiishii/dotfiles/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nozomiishii/dotfiles.git"
  },
  "type": "module",
  "main": "install.sh",
  "scripts": {
    "format": "pnpm oxfmt . --check",
    "format:fix": "pnpm oxfmt .",
    "lint": "pnpm markdownlint",
    "lint:fix": "pnpm markdownlint:fix",
    "markdownlint": "npx -y markdownlint-cli2@latest '**/*.md' '#node_modules'",
    "markdownlint:fix": "npx -y markdownlint-cli2-fix@latest '**/*.md' '#node_modules'",
    "oxfmt": "oxfmt",
    "postinstall": "postinstall"
  },
  "devDependencies": {
    "@nozomiishii/commitlint-config": "2.7.0",
    "@nozomiishii/lefthook-config": "2.7.0",
    "@nozomiishii/markdownlint-cli2-config": "2.7.0",
    "@nozomiishii/oxfmt-config": "2.7.0",
    "@nozomiishii/postinstall": "2.7.0",
    "lefthook": "2.1.14",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "0.67.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
