{
  "command-permissions": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/share/mise/shims:$PATH\" bun \"$HOME/.local/bin/antigravity-pre-tool-use.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
